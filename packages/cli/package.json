{
  "name": "@zswarm/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "zSwarm CLI \u2014 list, send, dump Zellij panes",
  "bin": {
    "zswarm": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node dist/cli.js",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "dependencies": {
    "@zswarm/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./package.json": "./package.json"
  }
}
