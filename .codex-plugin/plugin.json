{
  "name": "zswarm",
  "version": "0.1.5",
  "description": "zSwarm — coordinate CLI crews in Zellij panes (list, send, dump).",
  "author": {
    "name": "zSwarm"
  },
  "license": "MIT",
  "keywords": [
    "zellij",
    "panes",
    "mcp",
    "swarm",
    "cli"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "zswarm": {
      "command": "node",
      "args": [
        "./bin/launch-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "ZSWARM_BIN",
        "ZSWARM_PATH",
        "ZSWARM_SESSION",
        "ZSWARM_SELF_PANE",
        "ZELLIJ_PANE_ID",
        "ZSWARM_FROM",
        "ZSWARM_SSH",
        "ZSWARM_TMP",
        "ZSWARM_SSH_MODE",
        "ZSWARM_REMOTE_BIN",
        "ZSWARM_SERVE",
        "ZSWARM_SERVE_TOKEN",
        "ZSWARM_READONLY",
        "ZSWARM_ALLOW_PANES",
        "ZSWARM_DENY_PANES",
        "ZSWARM_ALLOW_SPAWN",
        "ZSWARM_ALLOW_CLOSE",
        "ZSWARM_ALLOW_WORKTREE_REMOVE"
      ]
    }
  },
  "interface": {
    "displayName": "zSwarm",
    "shortDescription": "Pane coordination for CLI crews",
    "longDescription": "List Zellij panes, send prompts into another CLI pane, and dump scrollback. Local Zellij only.",
    "developerName": "zSwarm",
    "category": "Developer Tools",
    "capabilities": [
      "Instructions",
      "Read",
      "Write"
    ],
    "defaultPrompt": [
      "Use zswarm({op:\"list\"}) to see panes, then zswarm({op:\"send\", to, body}) to message another CLI in Zellij.",
      "Use zswarm({op:\"dump\", to}) sparingly for a short screen read; prefer small dumps over full scrollback."
    ]
  }
}
